PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/wattar-chair
NODE_ENV=development

# مهم: أنشئ قيمة عشوائية بالأمر:  npm run gen-secret
JWT_SECRET=

# حساب المدير (يُنشأ تلقائيًا عند أول تشغيل). اختر كلمة مرور قوية!
ADMIN_EMAIL=admin@wattarchair.com
ADMIN_PASSWORD=replace-with-your-own-strong-password

CLIENT_URL=http://localhost:5173
# TRUST_PROXY=1   # فعّله إذا كان الخادم خلف Nginx/Cloudflare

# الذكاء الاصطناعي (اختياري)
# أنشئ مفتاحًا خاصًا بك من Google AI Studio وضعه في backEnd/.env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# البريد الإلكتروني (اختياري لكن مطلوب لاستعادة كلمة المرور وتأكيد البريد وإشعارات المدير)
# إن تُرك SMTP_HOST فارغًا: تُطبع الروابط في سجل الخادم ويُعتبر البريد مؤكدًا تلقائيًا.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Wattar Chair <no-reply@example.com>"

# الصور تُخزَّن في MongoDB (GridFS). UPLOAD_DIR يُستخدم فقط لنقل صور قديمة: npm run migrate:uploads
# UPLOAD_DIR=./uploads

# الدولة والعملة (يجب أن تتطابق مع frontEnd/src/config/locale.js)
COUNTRY_CODE=963
CURRENCY_CODE=USD
CURRENCY_SYMBOL=$
